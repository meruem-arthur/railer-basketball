// ============================================================
// SRID RAILERS — DATABASE SCHEMA
// PostgreSQL (Neon) via Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum PlayerPosition {
  POINT_GUARD
  SHOOTING_GUARD
  SMALL_FORWARD
  POWER_FORWARD
  CENTER
}

enum AcademicLevel {
  LEVEL_100
  LEVEL_200
  LEVEL_300
  LEVEL_400
  LEVEL_500
  GRADUATE
  ALUMNI
}

enum GameStatus {
  UPCOMING
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum HomeAway {
  HOME
  AWAY
  NEUTRAL
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsCategoryName {
  TEAM_NEWS
  MATCH_REPORT
  TRAINING
  TOURNAMENT
  PLAYER_NEWS
  ANNOUNCEMENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum TryoutStatus {
  PENDING
  SHORTLISTED
  APPROVED
  REJECTED
  CONTACTED
}

enum GalleryAlbumCategory {
  GAME_DAY
  TRAINING
  TEAM
  TOURNAMENTS
  EVENTS
  BEHIND_THE_SCENES
}

enum MediaFolder {
  PLAYERS
  GALLERY
  NEWS
  TEAMS
  OPPONENTS
  MISC
}

// ------------------------------------------------------------
// USERS / AUTH
// ------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(EDITOR)
  active        Boolean   @default(true)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  resetTokens   PasswordResetToken[]
  newsArticles  NewsArticle[]
  auditLogs     AuditLog[]
  galleryAlbums GalleryAlbum[]

  @@index([role])
  @@index([active])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ------------------------------------------------------------
// SEASONS
// ------------------------------------------------------------

model TeamSeason {
  id          String   @id @default(cuid())
  label       String   @unique // e.g. "2026/27"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerSeasons   PlayerSeason[]
  games           Game[]
  teamGameStats   TeamGameStat[]

  @@index([isCurrent])
  @@index([isArchived])
}

// ------------------------------------------------------------
// PLAYERS
// ------------------------------------------------------------

model Player {
  id                String        @id @default(cuid())
  firstName         String
  lastName          String
  slug              String        @unique
  dateOfBirth       DateTime?
  heightCm          Int?
  hometown          String?
  academicLevel     AcademicLevel?
  programme         String?
  bio               String?
  yearJoined         Int?
  photoPublicId     String?
  photoUrl          String?
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  seasons           PlayerSeason[]

  @@index([active])
  @@index([slug])
}

model PlayerSeason {
  id           String         @id @default(cuid())
  playerId     String
  player       Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId     String
  season       TeamSeason     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  jerseyNumber Int
  position     PlayerPosition
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  gameStats    PlayerGameStat[]

  @@unique([playerId, seasonId])
  @@unique([seasonId, jerseyNumber])
  @@index([seasonId])
  @@index([playerId])
}

// ------------------------------------------------------------
// OPPONENTS
// ------------------------------------------------------------

model Opponent {
  id            String   @id @default(cuid())
  name          String   @unique
  logoPublicId  String?
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  games         Game[]
}

// ------------------------------------------------------------
// GAMES
// ------------------------------------------------------------

model Game {
  id             String     @id @default(cuid())
  seasonId       String
  season         TeamSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  opponentId     String?
  opponent       Opponent?  @relation(fields: [opponentId], references: [id])
  opponentName   String
  opponentLogoUrl String?
  dateTime       DateTime
  venue          String
  homeAway       HomeAway   @default(HOME)
  competition    String     @default("Friendly")
  status         GameStatus @default(UPCOMING)
  railersScore   Int?
  opponentScore  Int?
  gameReport     String?
  highlightUrl   String?
  mvpPlayerSeasonId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  quarterScores  GameQuarterScore[]
  playerStats    PlayerGameStat[]
  teamStats      TeamGameStat[]
  galleryAlbums  GalleryAlbum[]

  @@index([seasonId])
  @@index([status])
  @@index([dateTime])
}

model GameQuarterScore {
  id             String @id @default(cuid())
  gameId         String
  game           Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  quarter        Int    // 1,2,3,4,5+ (5 = OT1, 6 = OT2 ...)
  railersScore   Int
  opponentScore  Int

  @@unique([gameId, quarter])
  @@index([gameId])
}

// ------------------------------------------------------------
// STATISTICS
// ------------------------------------------------------------

model PlayerGameStat {
  id                      String       @id @default(cuid())
  gameId                  String
  game                    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerSeasonId          String
  playerSeason            PlayerSeason @relation(fields: [playerSeasonId], references: [id], onDelete: Cascade)

  minutes                 Int?
  points                  Int          @default(0)
  rebounds                Int          @default(0)
  assists                 Int          @default(0)
  steals                  Int          @default(0)
  blocks                  Int          @default(0)
  turnovers               Int          @default(0)
  fouls                   Int          @default(0)
  fieldGoalsMade          Int          @default(0)
  fieldGoalsAttempted     Int          @default(0)
  threePointersMade       Int          @default(0)
  threePointersAttempted  Int          @default(0)
  freeThrowsMade          Int          @default(0)
  freeThrowsAttempted     Int          @default(0)

  createdAt               DateTime     @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([gameId, playerSeasonId])
  @@index([playerSeasonId])
  @@index([gameId])
}

model TeamGameStat {
  id            String     @id @default(cuid())
  gameId        String     @unique
  game          Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seasonId      String
  season        TeamSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  rebounds      Int        @default(0)
  assists       Int        @default(0)
  turnovers     Int        @default(0)
  fieldGoals    Int        @default(0)
  fieldGoalAttempts Int    @default(0)

  @@index([seasonId])
}

// ------------------------------------------------------------
// NEWS
// ------------------------------------------------------------

model NewsCategory {
  id      String            @id @default(cuid())
  name    NewsCategoryName  @unique
  label   String

  articles NewsArticle[]
}

model NewsArticle {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  excerpt        String
  content        String
  featuredImageUrl String?
  featuredImagePublicId String?
  categoryId     String
  category       NewsCategory @relation(fields: [categoryId], references: [id])
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  status         NewsStatus   @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([categoryId])
}

// ------------------------------------------------------------
// GALLERY
// ------------------------------------------------------------

model GalleryAlbum {
  id            String               @id @default(cuid())
  title         String
  slug          String               @unique
  category      GalleryAlbumCategory
  description   String?
  coverImageUrl String?
  gameId        String?
  game          Game?                @relation(fields: [gameId], references: [id])
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  images        GalleryImage[]

  @@index([category])
  @@index([slug])
}

model GalleryImage {
  id             String       @id @default(cuid())
  albumId        String
  album          GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String
  secureUrl      String
  width          Int?
  height         Int?
  altText        String
  caption        String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([albumId])
}

// ------------------------------------------------------------
// ANNOUNCEMENTS
// ------------------------------------------------------------

model Announcement {
  id            String               @id @default(cuid())
  title         String
  content       String
  priority      AnnouncementPriority @default(NORMAL)
  status        AnnouncementStatus   @default(DRAFT)
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([expiresAt])
}

// ------------------------------------------------------------
// TRYOUTS
// ------------------------------------------------------------

model TryoutApplication {
  id                    String        @id @default(cuid())
  fullName              String
  studentId             String
  programme             String
  level                 AcademicLevel
  phone                 String
  email                 String
  dateOfBirth           DateTime
  position              PlayerPosition
  heightCm              Int?
  previousExperience    String?
  yearsPlayed           Int?
  preferredJerseyNumber Int?
  motivation            String
  emergencyContactName  String
  emergencyContactPhone String
  photoUrl              String?
  photoPublicId         String?
  status                TryoutStatus  @default(PENDING)
  adminNotes            String?
  createdAt             DateTime      @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([status])
  @@index([position])
  @@index([level])
  @@index([createdAt])
}

// ------------------------------------------------------------
// SITE SETTINGS
// ------------------------------------------------------------

model SiteSetting {
  id            String   @id @default("singleton")
  teamName      String   @default("UMaT SRID Railers")
  slogan        String   @default("Speed. Precision. Victory.")
  aboutText     String?
  contactEmail  String?
  contactPhone  String?
  venue         String?
  logoUrl       String?
  currentSeasonId String?
  updatedAt     DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   // instagram, facebook, tiktok, x, youtube
  url       String
  active    Boolean  @default(true)

  @@unique([platform])
}

// ------------------------------------------------------------
// MEDIA ASSETS (generic, for anything not covered above)
// ------------------------------------------------------------

model MediaAsset {
  id            String      @id @default(cuid())
  folder        MediaFolder
  publicId      String
  secureUrl     String
  resourceType  String      @default("image")
  width         Int?
  height        Int?
  altText       String?
  caption       String?
  createdAt     DateTime    @default(now())

  @@index([folder])
}

// ------------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
